{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.1"
        }
    },
    "routes": [
        {
            "src": "/imgs/(.*)",
            "dest": "/imgs/$1",
            "headers": { "cache-control": "s-maxage=31536000, immutable" }
        },
        {
            "src": "/images/(.*)",
            "dest": "/images/$1",
            "headers": { "cache-control": "s-maxage=31536000, immutable" }
        },
        {
            "src": "/storage/(.*)",
            "dest": "/storage/$1",
            "headers": { "cache-control": "s-maxage=31536000, immutable" }
        },
        {
            "src": "/css/(.*)",
            "dest": "/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}